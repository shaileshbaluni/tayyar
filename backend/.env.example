# Tayyar backend — copy to backend/.env (never commit .env)

# development | production
ENVIRONMENT=development

DAILY_API_KEY=
DAILY_SUBDOMAIN=

PIPECTAT_ENABLED=false
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

LLM_PROVIDER=gemini
LLM_MODEL=gpt-4o

STORAGE_DIR=storage

# Comma-separated browser origins (required in production)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Optional: require X-Admin-Key header on /api/v1/admin/*
ADMIN_API_KEY=
