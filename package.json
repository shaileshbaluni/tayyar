{
  "name": "tayyar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev": "node server.mjs",
    "dev:api": "cd backend && python -m uvicorn server:app --host 127.0.0.1 --port 8000 --reload",
    "dev:vite": "npm --prefix frontend run dev",
    "start": "node server.mjs",
    "start:api": "cd backend && python -m uvicorn server:app --host 0.0.0.0 --port 8000",
    "prestart": "npm run build",
    "check": "npm --prefix frontend run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ws": "^8.20.0"
  }
}
